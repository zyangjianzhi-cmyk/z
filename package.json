{
  "name": "lumina-dreamina-studio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Lumina desktop creative studio for Dreamina",
  "main": "desktop/main.mjs",
  "author": "Lumina Studio",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "desktop": "electron .",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run desktop:prepare && electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "studio.lumina.desktop",
    "productName": "Lumina",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "server.mjs",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/dreamina.exe",
        "to": "dreamina.exe"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "desktop/assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Lumina-${version}-Windows.exe"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  }
}
